# Chế độ mặc định: tra cứu nguồn cục bộ, không gọi API.
# Bật lớp ngôn ngữ OpenAI cho ô chat bằng BHYT_CHAT_AI=1.
BHYT_CHAT_AI=0
# Công tắc cũ dành riêng cho API tra cứu legacy, nên giữ 0.
BHYT_ENABLE_AI=0
OPENAI_API_KEY=
# Điền model Responses mà tài khoản của bạn được phép sử dụng.
OPENAI_MODEL=
BHYT_AI_TIMEOUT=12
# Chỉ cần cho bước tạo/truy vấn embedding; điền model embedding được hỗ trợ.
OPENAI_EMBEDDING_MODEL=
